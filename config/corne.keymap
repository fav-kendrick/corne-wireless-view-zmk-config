#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        del {
            bindings = <&kp DELETE>;
            key-positions = <11 6>;
        };
    };

    behaviors {
        gpt: gpt {
            compatible = "zmk,behavior-hold-tap";
            label = "GLOBAL_QUICK_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
        };

        layer_2_3: layer_2_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2_3";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 3>;
        };

        gui_ctrl: gui_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "GUI_CTRL";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LEFT_CONTROL>;

            tapping-term-ms = <300>;
        };

        ht_layers: ht_layers {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYERS";
            bindings = <&to>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
        };

        layer_tap_hold: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_HOLD";
            bindings = <&kp>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
        };

        layer1_terminal: layer1_terminal {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER1_TERMINAL";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LC(GRAVE)>;
        };

        quote_grave: quote_grave {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTE_GRAVE";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp GRAVE>;
        };

        default_layer_switcher: default_layer_switcher {
            compatible = "zmk,behavior-hold-tap";
            label = "DEFAULT_LAYER_SWITCHER";
            bindings = <&mo>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <200>;
            flavor = "balanced";
        };
    };

    macros {
        terminal_macro: terminal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp GRAVE>;
            label = "TERMINAL_MACRO";
        };

        arrow_highlight: arrow_highlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp LEFT_SHIFT>;
            label = "ARROW_HIGHLIGHT";
        };

        chrome_next_tab: chrome_next_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp TAB>;
            label = "CHROME_NEXT_TAB";
        };

        chrome_prev_tab: chrome_prev_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp TAB>;
            label = "CHROME_PREV_TAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "BASE";
            bindings = <
&kp ESCAPE             &kp Q  &kp W  &kp F         &kp P                        &kp B        &kp J      &kp L                        &kp U      &kp Y    &kp SINGLE_QUOTE  &kp BSPC
&gpt LEFT_CONTROL TAB  &kp A  &kp R  &kp S         &kp T                        &kp G        &kp M      &kp N                        &kp E      &kp I    &kp O             &kp MINUS
&kp LSHFT              &kp Z  &kp X  &kp C         &kp D                        &kp V        &kp K      &kp H                        &kp COMMA  &kp DOT  &kp FSLH          &kp SEMI
                                     &kp LEFT_GUI  &default_layer_switcher 1 0  &kp SPACE    &kp ENTER  &default_layer_switcher 2 0  &kp RALT
            >;
        };

        NAV {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "NAV";
            bindings = <
&kp ESCAPE  &none  &kp RA(LEFT)  &kp UP    &kp RA(RIGHT)  &kp PAGE_UP      &none          &kp LC(LEFT)       &none   &kp LC(RIGHT)  &none                   &kp BSPC
&trans      &none  &kp LEFT      &kp DOWN  &kp RIGHT      &kp PAGE_DOWN    &kp LS(LG(K))  &kp LG(J)          &none   &kp LG(K)      &kp LC(RA(LEFT_ARROW))  &kp LC(RA(RIGHT_ARROW))
&kp LSHFT   &none  &kp LG(LEFT)  &none     &kp LG(RIGHT)  &kp F7           &kp F12        &kp LC(LS(TAB))    &none   &kp LC(TAB)    &kp LC(RA(I))           &kp LC(RA(K))
                                 &trans    &none          &trans           &trans         &kp LC(RA(ENTER))  &trans
            >;
        };

        NUM {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "NUM";
            bindings = <
&kp ESCAPE  &kp EXCLAMATION  &kp AT     &kp HASH   &kp DOLLAR      &kp PERCENT        &kp CARET         &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BSPC
&trans      &kp N1           &kp N2     &kp N3     &kp N4          &kp N5             &kp N6            &kp N7             &kp N8        &kp N9                &kp N0                 &none
&kp LSHFT   &none            &kp GRAVE  &kp EQUAL  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE      &kp BACKSLASH         &none                  &mo 3
                                        &trans     &none           &trans             &trans            &none              &trans
            >;
        };

        MEDIA {
            bindings = <
&bt BT_CLR_ALL  &bt BT_NXT  &none  &trans  &trans  &to 4     &trans  &trans           &trans            &trans             &trans  &trans
&to 0           &none       &none  &trans  &trans  &trans    &trans  &kp C_VOLUME_UP  &kp K_MUTE        &kp C_VOLUME_DOWN  &trans  &to 0
&trans          &none       &none  &trans  &trans  &trans    &trans  &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT         &trans  &trans
                                   &none   &trans  &trans    &trans  &trans           &none
            >;

            label = "MEDIA";
        };

        GAME {
            display-name = "GAME";
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp F      &kp P     &kp B        &kp J      &kp L     &kp U           &kp Y    &kp SINGLE_QUOTE  &kp BSPC
&kp TAB     &kp A  &kp R  &kp S      &kp T     &kp G        &kp M      &kp N     &kp E           &kp I    &kp O             &kp MINUS
&kp LSHFT   &kp Z  &kp X  &kp C      &kp D     &kp V        &kp K      &kp H     &kp COMMA       &kp DOT  &kp FSLH          &kp SEMI
                          &kp LCTRL  &kp LALT  &kp SPACE    &kp ENTER  &kp RGUI  &ht_layers 0 4
            >;
        };
    };
};
